{
  "java.configuration.updateBuildConfiguration": "automatic",
  "java.debug.settings.enableRunDebugCodeLens": false,
  "code-runner.runInTerminal": true,
  "code-runner.cwd": "$workspaceRoot",
  "code-runner.executorMap": {
    "java": "\"$workspaceRoot\\.vscode\\run-spring-boot.cmd\""
  },
  "editor.semanticHighlighting.enabled": true,
  "editor.semanticTokenColorCustomizations": {
    "rules": {
      "class:java": "#6A9955",
      "type:java": "#6A9955"
    }
  },
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": [
          "support.class.java",
          "entity.name.type.class.java"
        ],
        "settings": {
          "foreground": "#6A9955"
        }
      }
    ]
  },
  "testing.automaticallyOpenPeekView": "failure",
  "terminal.integrated.fontFamily": "CaskaydiaCove Nerd Font, Cascadia Code, Consolas, monospace",
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.lineHeight": 1.2,
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.shellIntegration.enabled": true,
  "terminal.integrated.suggest.enabled": true,
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "a-file-icon-vscode.activeIconPacks": [
    "rails",
    "angular",
    "react",
    "phalcon"
  ],
  "a-file-icon-vscode.arrowTheme": "material",
  "a-file-icon-vscode.folderColor": "#90a4ae",
  "a-file-icon-vscode.folderTheme": "specific",
  "a-file-icon-vscode.opacity": 1,
  "a-file-icon-vscode.saturation": 1
}